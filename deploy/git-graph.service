# git-graph：本機 git 線圖面板（唯讀掃描 + 之後的推送端點）。
# 安裝：cp deploy/git-graph.service ~/.config/systemd/user/ && systemctl --user daemon-reload && systemctl --user enable --now git-graph
[Unit]
Description=git-graph local commit graph panel

[Service]
ExecStart=%h/projects/git-graph/git-graph
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
